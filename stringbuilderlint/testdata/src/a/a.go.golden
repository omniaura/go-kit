package a

import (
	"strings"
)

func twoParts(a, b string) string {
	return a + b
}

func threeParts(a, b, c string) string {
	return func() string {
		builderPart0 := a
		builderPart2 := b
		builderPart4 := c
		var sb strings.Builder
		sb.Grow(len(builderPart0) + 1 + len(builderPart2) + 1 + len(builderPart4))
		sb.WriteString(builderPart0)
		sb.WriteString(":")
		sb.WriteString(builderPart2)
		sb.WriteString(":")
		sb.WriteString(builderPart4)
		return sb.String()
	}() // want "string concatenation with 5 parts should use strings.Builder"
}

func nested(a, b, c string) string {
	return func() string {
		builderPart0 := a
		builderPart1 := b
		builderPart2 := c
		var sb strings.Builder
		sb.Grow(len(builderPart0) + len(builderPart1) + len(builderPart2))
		sb.WriteString(builderPart0)
		sb.WriteString(builderPart1)
		sb.WriteString(builderPart2)
		return sb.String()
	}() // want "string concatenation with 3 parts should use strings.Builder"
}

func constantOnly() string {
	return "a" + "b" + "c"
}

func ignored(a, b, c string) string {
	//lint:ignore stringbuilderlint fixture verifies line suppression
	return a + b + c
}
